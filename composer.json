{
    "name": "ikechukwukalu/makeservice",
    "description": "A laravel package for scaffolding service classes.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Ikechukwukalu\\Makeservice\\": "src/",
            "Ikechukwukalu\\Makeservice\\Console\\Commands\\": "src/Console/Commands/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ikechukwukalu\\Makeservice\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "authors": [
        {
            "name": "Ikechukwu Kalu",
            "email": "ea.ikechukwukalu@gmail.com"
        }
    ],
    "require": {
        "illuminate/console": "^12.0",
        "illuminate/support": "^12.0",
        "symfony/console": "^7.2",
        "php": "^8.2"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5",
        "php-parallel-lint/php-parallel-lint": "^1.4"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ikechukwukalu\\Makeservice\\MakeServiceServiceProvider"
            ]
        }
    }
}
